      "script": {
        "type": "text/javascript",
        "exec": [
          "// DIAGNÓSTICO DEL AMBIENTE: corre después de CADA petición, antes de sus validaciones.",
          "// Si el servidor no respondió o respondió 5xx, la falla es del ambiente y no un bug.",
          "const code = pm.response ? pm.response.code : undefined;",
          "if (typeof code !== 'number') {",
          "  pm.variables.set('_ambienteFalla', 'si');",
          "  pm.test('⚠️ AMBIENTE: el servidor no respondió a tiempo (no es un bug de la app)', () => {",
          "    throw new Error('Sin respuesta del servidor. Espera unos minutos y vuelve a ejecutar.');",
          "  });",
          "} else if (code >= 500) {",
          "  pm.variables.set('_ambienteFalla', 'si');",
          "  pm.test(`⚠️ AMBIENTE: el servidor respondió ${code} (no es un bug de la app)`, () => {",
          "    throw new Error(`Servidor no disponible (${code}). Espera unos minutos y vuelve a ejecutar.`);",
          "  });",
          "  if (code === 503) {",
          "    console.log('⚠️  FALLA DEL AMBIENTE: la app respondió 503 (servidor caído). Se detiene la ejecución: espera unos minutos y vuelve a ejecutar.');",
          "    postman.setNextRequest(null);",
          "  }",
          "} else {",
          "  pm.variables.set('_ambienteFalla', 'no');",
          "}"
        ]
      }
    }
