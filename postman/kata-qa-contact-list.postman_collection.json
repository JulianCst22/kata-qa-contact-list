{
  "info": {
    "_postman_id": "e6e5d4c4-7820-4d63-960a-41180b3a5cf4",
    "name": "Kata QA - Contact List API",
    "description": "Casos de prueba de API (API-01 a API-20) del plan de pruebas de la Kata Junior QA.\n\nSe ejecutan en orden con el Collection Runner o con Newman: cada petición guarda en variables de la colección lo que necesita la siguiente (email, token, id del contacto).\n\nDocumentación de la API: https://documenter.getpostman.com/view/4012288/TzK2bEa8",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Usuarios",
      "description": "Registro de usuarios (positivo y negativos).",
      "item": [
        {
          "name": "API-01 Crear un usuario nuevo",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Email único en cada ejecución: la base de datos de la app se reinicia seguido",
                  "const unique = Date.now() + '' + Math.floor(Math.random() * 10000);",
                  "pm.collectionVariables.set('email', `julian.${unique}@test.com`);",
                  "pm.collectionVariables.set('contactEmail', `juan.${unique}@test.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Si el servidor falló (ver script de la colección), no se validan los datos",
                  "if (pm.variables.get('_ambienteFalla') !== 'si') {",
                  "  pm.test(\"Código 201 (creado)\", () => pm.response.to.have.status(201));",
                  "  const body = pm.response.json();",
                  "  pm.test(\"La respuesta incluye un token\", () => pm.expect(body.token).to.be.a('string').and.not.empty);",
                  "  pm.test(\"La respuesta incluye el email del usuario\", () => pm.expect(body.user.email).to.eql(pm.collectionVariables.get('email')));",
                  "  pm.collectionVariables.set('token', body.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Julian\",\n  \"lastName\": \"QA\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "API-02 Crear usuario con email ya registrado",
